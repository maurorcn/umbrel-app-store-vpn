# ============================================================
# AirVPN + Gluetun (WireGuard)
# Copiar para: ~/umbrel/app-data/<id-da-app>/gluetun.env
#   ex.: ~/umbrel/app-data/vpn-qbittorrent/gluetun.env
# chmod 600 no ficheiro (contém chaves privadas)
# ============================================================
#
# Onde obter os valores:
#   AirVPN → Client Area → "Config Generator" → Linux → protocolo WireGuard
#   Escolhe o dispositivo (Device), gera o ficheiro .conf e copia:
#     [Interface] PrivateKey  -> WIREGUARD_PRIVATE_KEY
#     [Interface] Address     -> WIREGUARD_ADDRESSES
#     [Peer]      PresharedKey-> WIREGUARD_PRESHARED_KEY
# Sem aspas e sem espaços à volta do "=".

VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard

WIREGUARD_PRIVATE_KEY=COLA_AQUI_A_PRIVATE_KEY
WIREGUARD_PRESHARED_KEY=COLA_AQUI_A_PRESHARED_KEY
# Só IPv4 (recomendado). Se o .conf tiver "10.x.x.x/32, fd7d:.../128" usa apenas a parte IPv4.
WIREGUARD_ADDRESSES=10.128.0.2/32

# Servidores (opcionais — escolhe um filtro; podes usar vários separados por vírgula)
SERVER_COUNTRIES=Netherlands
# SERVER_CITIES=Amsterdam
# SERVER_NAMES=Alkaid,Alrami

# ---------- Port forwarding ----------
# O AirVPN NÃO atribui portas automaticamente: reservas portas fixas em
#   Client Area → "Ports" → "Add" (escolhe TCP+UDP e o dispositivo/key usado acima).
# Depois abre essas portas no firewall do gluetun:
FIREWALL_VPN_INPUT_PORTS=16171
# Várias portas: FIREWALL_VPN_INPUT_PORTS=16171,16172
# E define a MESMA porta no cliente torrent:
#   qBittorrent: Opções → Ligação → "Porta para ligações de entrada" = 16171 (desativa UPnP/NAT-PMP)
#   Transmission: Preferências → Rede → "Porta de escuta" = 16171
# (NÃO uses VPN_PORT_FORWARDING=on com AirVPN)

# ---------- Opcional ----------
# Servidor de lista de servidores atualizada (útil se o servidor escolhido desaparecer)
# UPDATER_PERIOD=24h
