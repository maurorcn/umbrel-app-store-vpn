# Copia para ~/umbrel/app-data/<id-da-app>/gluetun.env e edita.
# Lista de fornecedores/variáveis: https://github.com/qdm12/gluetun-wiki

# ---------- OPÇÃO A: WireGuard (recomendado) ----------
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=COLOCA_AQUI_A_TUA_CHAVE_PRIVADA
WIREGUARD_ADDRESSES=10.64.222.21/32
SERVER_COUNTRIES=Portugal

# ---------- OPÇÃO B: OpenVPN ----------
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=utilizador
# OPENVPN_PASSWORD=password
# SERVER_COUNTRIES=Portugal

# ---------- Port forwarding (só ProtonVPN / PIA / Perfect Privacy / Privado) ----------
# VPN_PORT_FORWARDING=on
# Para o qBittorrent usar automaticamente a porta atribuída (só na app qBittorrent):
# VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":{{PORTS}}}" http://127.0.0.1:8080/api/v2/app/setPreferences 2>&1'
